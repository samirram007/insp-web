# Port the SSR server binds inside the container (default 3000)
PORT=3000

# --- Contact Us mail -------------------------------------------------------
# SMTP relay used by the Contact Us form. Server-only: never prefix these
# with VITE_ or they would be exposed to the browser.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=no-reply@example.com
SMTP_PASS=replace-me

# Inbox that receives contact form submissions. Defaults to SMTP_USER.
CONTACT_TO_EMAIL=info@example.com

# Rate limit for the contact form: submissions allowed per client IP within
# the window below. In-memory, per process; defaults to 5.
CONTACT_RATE_LIMIT=5
# Window length in seconds (default 600 = 10 minutes).
CONTACT_RATE_LIMIT_WINDOW=600
